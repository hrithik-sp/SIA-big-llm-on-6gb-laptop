+// Width (nats) of the window of log-probabilities below the top one that --kl-divergence-base stores and
+// --kl-divergence counts. Default 16. LLAMA_PERPLEXITY_KLD_WINDOW widens it for references that are unsure of
+// the text (a true token below the window is stored at the floor, which distorts PPL(base) and, slightly, KLD).
+// Both passes must use the same value.
+static float kld_window() {
+    static const float w = [] {
+        const char * s = getenv("LLAMA_PERPLEXITY_KLD_WINDOW");
+        const float v = s ? (float) atof(s) : 16.f;
+        return v > 0 ? v : 16.f;
+    }();
+    return w;
+}
