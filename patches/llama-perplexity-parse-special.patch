+// LLAMA_PERPLEXITY_PARSE_SPECIAL=1: tokenize the input with parse_special, so chat-template
+// markers in a chat-formatted evaluation text become real special tokens (default: literal text)
+static bool ppl_parse_special() {
+    const char * env = getenv("LLAMA_PERPLEXITY_PARSE_SPECIAL");
+    return env != nullptr && atoi(env) == 1;
+}
